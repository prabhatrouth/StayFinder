<%- layout("layout/boilerplate") %>

<h3 class="mt-3">My Listings</h3>

<% if(myListings.length === 0){ %>
  <p class="text-muted">You have no listings</p>
<% } %>

<div class="row mt-3">

  <% for(let listing of myListings){ %>

    <div class="col-md-4 mb-3">

      <div class="card shadow-sm">

        <img 
          src="<%= typeof listing.image === 'string' ? listing.image : (listing.image?.url || 'https://via.placeholder.com/400x300') %>" 
          class="card-img-top"
          style="height: 200px; object-fit: cover;"
        >

        <div class="card-body">

          <h5><%= listing.title %></h5>

          <p>₹<%= listing.price %></p>

          <a href="/listings/<%= listing._id %>" class="btn btn-primary btn-sm">
            View
          </a>

          <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning btn-sm">
            Edit
          </a>

          <form 
            method="POST" 
            action="/listings/<%= listing._id %>?_method=DELETE"
            style="display:inline;"
          >
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>

        </div>

      </div>

    </div>

  <% } %>

</div>